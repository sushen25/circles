# Public client configuration. Copy to `.env.local` and fill in.
#
# Everything here is compiled into the client bundle and is readable by anyone
# who opens the app. Nothing secret belongs in this file or in any `.env`
# (architecture §5.3). Secrets live in Edge Function config and are set with
# `supabase secrets set` — see docs/runbooks/environments.md.
#
# `.env*` is gitignored apart from this example. If you find yourself wanting
# to add a value here that would be damaging to publish, it belongs in
# `supabase secrets set` instead.

# Which environment this build is for: development | preview | production.
# On EAS, EAS_BUILD_PROFILE supplies this and it can be left unset.
EXPO_PUBLIC_APP_ENV=development

# The Supabase project this client talks to. Local values are printed by
# `pnpm db:start`; hosted values come from the project's API settings.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where the app is served. Native builds resolve the link-preview route (§9.4)
# relative to this, so it must be set for anything but web.
EXPO_PUBLIC_APP_ORIGIN=http://localhost:8081

# Cloudflare Turnstile, invisible mode. The site key is public; the secret that
# pairs with it is an Edge Function secret. Leave empty to disable the widget
# locally — anonymous joins are not gated in the local stack.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

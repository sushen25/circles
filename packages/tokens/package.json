{
  "name": "@circles/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./font-assets": {
      "types": "./dist/font-assets.d.ts",
      "default": "./dist/font-assets.js"
    },
    "./assets/fonts/*": "./assets/fonts/*"
  },
  "files": [
    "dist",
    "assets"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run"
  }
}

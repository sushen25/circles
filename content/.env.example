# Copy to .env and fill in. Never commit .env.
# BSKY_HANDLE, THREADS_USER_ID and IG_USER_ID are account ids, not secrets:
# each is public on every post, so the analytics workflows read them as
# repository variables; the tokens beside them stay secrets.

# Bluesky: Settings → App passwords. Posting the MP4 needs the account's
# email verified (Settings → Account), and Bluesky caps video uploads a day.
BSKY_HANDLE=wennaapp.bsky.social
BSKY_APP_PASSWORD=

# Threads: Meta app with threads_basic + threads_content_publish; the nightly
# pull reads with threads_manage_insights and threads_read_replies on the same token.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Threads and Instagram tokens last 60 days. `npm run tokens -- --github` (or
# `npm run refresh:tokens -- --github`) renews both once they are a day old and
# records when they expire; the publisher warns 10 days ahead, the nightly
# pull fails 7 days ahead.
# THREADS_TOKEN_EXPIRES=2026-12-20
# IG_TOKEN_EXPIRES=2026-12-20

# Instagram: Graph API, Standard Access for your own professional account.
# The MP4 is posted as a Reel (feed images are capped at 4:5). An IGAA… token
# (Instagram Login) goes to graph.instagram.com automatically.
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_GRAPH_HOST=graph.facebook.com   # only if auto-detect picks wrong
# IG_API_VERSION=v21.0               # the Graph API version the pull reads with

# LinkedIn: Community Management API, w_member_social
LINKEDIN_PERSON_ID=
LINKEDIN_ACCESS_TOKEN=

# YouTube: Google Cloud project with the YouTube Data API v3, an OAuth client
# of type "Desktop app", consent screen "In production" (in "Testing" the
# refresh token dies after 7 days). Then `npm run auth:youtube` prints the
# refresh token. Uploads stay private until Google's API audit passes;
# after that set YOUTUBE_PRIVACY=public.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_PRIVACY=private   # private | unlisted | public
# Reading (the nightly pull) needs youtube.readonly on the refresh token, and
# yt-analytics.readonly for retention and traffic; until that re-consent, an
# API key reads the public numbers and comment text, and with a key alone the
# channel id is needed for the account row and auto-claim.
# Comments (replies into inbox/) are read with the API key only, even after
# the re-consent: OAuth reads comments only under youtube.force-ssl, which can
# also edit and delete them, so that scope is never requested.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# TikTok: developer app with Login Kit (Desktop) and the Content Posting API,
# scope video.upload, redirect http://127.0.0.1:3455/callback/ registered.
# `npm run auth:tiktok` prints the refresh token (a year; the publisher
# refreshes the day-long access token on every run). The script only ever
# sends a draft to the inbox; you add a sound and post it in the app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# TIKTOK_REDIRECT_PORT=3455

# Where out/<slug>/NN.png is reachable by URL (Threads and Instagram fetch
# images server-side; TikTok fetches the NN.jpg stills, and only from a
# domain verified in the TikTok developer portal). It is media.wenna.app.
# The GitHub runner renders its own copies but cannot upload them, so put a
# piece there with `npm run upload queue/<file>.md` (AWS CLI) before
# approving it (docs/runbooks/content-media.md).
MEDIA_BASE_URL=https://media.wenna.app
# MEDIA_BUCKET=wenna-media

# Wenna's funnel by tag, for the pull (ADR 0087, analytics/platforms/wenna.ts):
# circles made, plans shared, answered and confirmed per `?from=` tag, counts
# only. WENNA_FUNNEL_URL is the `content-funnel` function's address
# (https://<project ref>.supabase.co/functions/v1/content-funnel); the secret
# is the function's CONTENT_FUNNEL_SECRET, set by the runbook in
# docs/runbooks/campaign-links.md. Either unset, the pull says "not configured".
# To try it on a laptop against the local stack: the URL is
# http://127.0.0.1:54321/functions/v1/content-funnel and the secret is
# `local-funnel` (supabase/config.toml).
WENNA_FUNNEL_URL=
CONTENT_FUNNEL_SECRET=

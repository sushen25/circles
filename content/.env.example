# Copy to .env and fill in. Never commit .env.
# Bluesky: Settings → App passwords
BSKY_HANDLE=wenna.bsky.social
BSKY_APP_PASSWORD=

# Threads: Meta app with threads_basic + threads_content_publish
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Instagram: Graph API, Standard Access for your own professional account.
# The MP4 is posted as a Reel (feed images are capped at 4:5). An IGAA… token
# (Instagram Login) goes to graph.instagram.com automatically.
IG_USER_ID=
IG_ACCESS_TOKEN=
# IG_GRAPH_HOST=graph.facebook.com   # only if auto-detect picks wrong

# LinkedIn: Community Management API, w_member_social
LINKEDIN_PERSON_ID=
LINKEDIN_ACCESS_TOKEN=

# Where out/<slug>/NN.png is reachable by URL (Threads and Instagram fetch
# images server-side). out/ is git-ignored, so GitHub cannot serve it: this
# is a bucket (R2 or S3) you upload out/<slug>/ to by hand before approving
# a piece (README, "Going live", step 3): the bucket's public base URL.
MEDIA_BASE_URL=

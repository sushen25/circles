# Client-bundle configuration only (architecture §5.3). Everything else —
# Resend, OAuth secrets, the Turnstile secret, the service-role key — lives in
# Edge Function secrets and must never appear here or in the repository.

# development | preview | production. Selects the bundle identifier and the
# EAS channel; EAS build profiles set it for you.
EXPO_PUBLIC_APP_ENV=development

# Filled in by S0-06 (local stack) and S0-11 (hosted projects).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key for anonymous joins (S0-11). Public by design.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# Where links live. Defaults to the brand domain; set it for local web runs.
EXPO_PUBLIC_APP_ORIGIN=http://localhost:8081

# Written by `eas init` (S0-02 hand-off) — see apps/app/README.md.
EAS_PROJECT_ID=

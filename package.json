{
  "name": "circles",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm run format:check && pnpm run lint && pnpm run check:brand && pnpm run check:tokens && pnpm run typecheck && pnpm run check:imports && pnpm run check:transitions && pnpm run check:events && pnpm run check:functions && pnpm run check:workflows && pnpm run test:unit && pnpm run db:test && pnpm run test:integration && pnpm run check:types && pnpm run test:e2e:smoke",
    "dev": "pnpm --filter app exec expo start",
    "dev:web": "pnpm --filter app exec expo start --web",
    "dev:ios": "pnpm --filter app run ios",
    "dev:android": "pnpm --filter app run android",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p tsconfig.functions.json && pnpm --filter app typecheck",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test:unit": "vitest run",
    "test:integration": "pnpm --filter app exec vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm run test:e2e:smoke",
    "test:e2e:smoke": "pnpm --filter app run export && playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase db reset && node scripts/check-function-coverage.mjs",
    "mail": "node scripts/local-mail.mjs",
    "gen:types": "supabase gen types typescript --local > packages/contracts/src/db.generated.ts",
    "gen:tokens": "node --experimental-strip-types scripts/gen-tokens.ts",
    "gen:transitions": "node scripts/gen-transitions.mjs",
    "gen:events": "node scripts/gen-events.mjs",
    "gen:functions": "node scripts/gen-sql-functions.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "check:tokens": "node --experimental-strip-types scripts/gen-tokens.ts --check",
    "check:types": "supabase gen types typescript --local | diff -u packages/contracts/src/db.generated.ts - || (echo \"check:types: packages/contracts/src/db.generated.ts is stale \u2014 run pnpm gen:types\" >&2; exit 1)",
    "check:imports": "node scripts/check-import-map.mjs",
    "check:transitions": "node scripts/gen-transitions.mjs --check",
    "check:events": "node scripts/gen-events.mjs --check",
    "check:functions": "node scripts/gen-sql-functions.mjs --check",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:env": "node scripts/check-environment.mjs",
    "check:client-env": "node scripts/check-client-env.mjs"
  },
  "devDependencies": {
    "@circles/config": "workspace:*",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supabase": "2.116.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.0",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
